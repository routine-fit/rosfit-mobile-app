{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ],
      "tests": [
        "tests/*"
      ]
    },
    "skipLibCheck": true,
    // "typeRoots": [
    //   "node_modules/@types",
    //   "src/types"
    // ],
  },
  "include": [
    "./src/**/*",
    "./tests/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "node_modules/reactotron-core-client"
  ]
}
