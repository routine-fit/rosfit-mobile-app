{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ],
      "tests": [
        "tests/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*",
    "./tests/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/Pods/**",
  ]
}
